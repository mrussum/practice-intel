# Copy to .env and fill in. Never commit .env.
# With no keys at all the app runs in demo mode with deterministic fake AI.

# --- LLM (Anthropic) -------------------------------------------------------
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5       # answers and fit analysis
FAST_MODEL=claude-haiku-4-5        # routing, extraction, summaries, eval judge
ANSWER_EFFORT=low                  # none | low | medium | high ("none" for models without effort)
FAKE_AI=0                          # 1 = force deterministic fakes (tests/CI)

# --- Embeddings ------------------------------------------------------------
EMBEDDING_PROVIDER=voyage          # voyage | openai | fake
EMBEDDING_MODEL=                   # default: voyage-3-large / text-embedding-3-small
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- Runtime ---------------------------------------------------------------
# Unset DATABASE_URL to run with an in-memory store (data lost on restart).
DATABASE_URL=postgres://career:career@localhost:5432/career
API_PORT=3001
WEB_ORIGIN=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info
UPLOAD_MAX_BYTES=5242880
RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=20

# --- Optional: Langfuse tracing (self-hosted or cloud) -----------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
