{
  "name": "career-intel",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "eval": "pnpm --filter @career-intel/evals eval",
    "seed": "pnpm --filter @career-intel/api seed",
    "test:e2e": "pnpm --filter @career-intel/web test:e2e"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
