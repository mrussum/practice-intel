# Rendered by the nginx image's envsubst step at container start
# (/etc/nginx/templates/*.template → /etc/nginx/conf.d/). Only defined env
# vars are substituted, so nginx's own $variables are left alone.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Security headers. Kept in the server block only: nginx drops inherited
    # add_header directives in any location that declares its own.
    #
    # CSP: everything from this origin; the one exception is fetch/SSE to the
    # API (API_ORIGIN). No inline scripts or styles are needed: Vite emits
    # external bundles, and React sets style via the CSSOM, which CSP allows.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
